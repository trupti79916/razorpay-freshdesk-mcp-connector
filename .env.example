# Freshdesk (Profile Settings -> API Key)
FRESHDESK_DOMAIN=yourcompany.freshdesk.com
FRESHDESK_API_KEY=your_api_key_here

# Guardrails
WRITE_ENABLED=false
REVEAL_PII=false
MAX_BODY_CHARS=4000
MAX_PAGES=3

# Rate limiting (stay below your plan's per-minute limit; trial is ~50/min)
RATE_LIMIT_PER_MIN=40
MAX_CONCURRENCY=3
MAX_RETRIES=4

AUDIT_LOG_PATH=audit.log.jsonl

# LLM for the demo agent (the MCP server itself needs no LLM). Pick any provider:
#   ollama (default, local) | openai | groq | openrouter | together | gemini | lmstudio | custom
# `custom` = any OpenAI-compatible endpoint (vLLM, proxies...). All of these can also be set in the UI sidebar.
LLM_PROVIDER=ollama
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# Provider-specific key vars are also read, e.g. OPENAI_API_KEY, GROQ_API_KEY, OPENROUTER_API_KEY, GEMINI_API_KEY

# Public deployments (e.g. Replit): set a password and disable write mode
APP_PASSWORD=
DISABLE_WRITE_MODE=false

# Ollama specifics (used when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
